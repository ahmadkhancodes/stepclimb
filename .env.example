# Copy to .env.local for dev. Never commit real values. Missing keys = stub mode.
APP_NAME=postslot
NEXT_PUBLIC_APP_URL=http://localhost:3000
# memory | mongo (defaults to mongo when MONGODB_URI is set)
DB_DRIVER=memory
MONGODB_URI=
MONGODB_DB=postslot
# >= 32 random chars, unique per app: openssl rand -base64 32
BETTER_AUTH_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# console | resend | smtp
MAIL_PROVIDER=console
RESEND_API_KEY=
MAIL_FROM=
CRON_SECRET=
ALTCHA_HMAC_KEY=
# JSON of remote flags, e.g. {"payments_enabled":"on"}
APP_FLAGS=
# comma separated founder admin emails
ADMIN_EMAILS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32+ random chars; encrypts GitHub App credentials in the database: openssl rand -base64 32
APP_ENCRYPTION_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Resend webhook signing secret (whsec_...): POST <host>/api/mail/webhook records hard bounces and complaints as suppressions
MAIL_WEBHOOK_SECRET=
# comma separated alert recipients (stuck runs, failed webhooks, stale cron); defaults to ADMIN_EMAILS
ALERT_EMAILS=
# comma separated extra repo globs Stepclimb refuses to touch, e.g. evil/*-malware
DENY_REPOS=
# scripts/backup.ts and the file sink: where backups are written
BACKUP_DIR=
